# Copy to .env and fill in values as needed.
# For IBM Skills Network labs, project_id "skills-network" often works without a personal API key.

# --- Data & Chroma ---
FOOD_DATA_PATH=data/FoodDataSet.json
CHROMA_PERSIST_DIR=chroma_db
EMBEDDING_MODEL=all-MiniLM-L6-v2
RAG_COLLECTION_NAME=enhanced_rag_food_chatbot
SEARCH_COLLECTION_NAME=food_similarity_search
DEFAULT_TOP_K=3

# --- IBM watsonx.ai / Granite ---
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_PROJECT_ID=skills-network
WATSONX_MODEL_ID=ibm/granite-4-h-small
WATSONX_MAX_NEW_TOKENS=400
# WATSONX_API_KEY=your_api_key_here
WATSONX_VERIFY=false

# --- Runtime behavior ---
ALLOW_LLM_FALLBACK=true
SKIP_LLM_HEALTHCHECK=false
